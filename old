  catch(e){}
}
function restoreUiState(){
  try{
    const raw = sessionStorage.getItem(UI_STATE_KEY);
    if(!raw) return;
    const saved = JSON.parse(raw);
    if(saved.isAdmin) isAdmin = true;
    if(saved.currentPos) currentPos = saved.currentPos;
    if(saved.currentTab) currentTab = saved.currentTab;
  }catch(e){}
}
// Sync is push-based and near-instant, so this is just a belt-and-braces
