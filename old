<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AEPi Draft Board</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A130E;
    --bg-2:#0D1A12;
    --panel:#12211A;
    --panel-2:#17281F;
    --panel-3:#1E3327;
    --line:#2C4536;
    --line-soft:#1F3327;
    --chalk:#F2EFE4;
    --chalk-dim:#A9B7AB;
    --chalk-faint:#6E7F72;
    --amber:#E7A93C;
    --amber-dim:#7C5C22;
    --amber-bright:#F6C563;
    --ink:#231603;
    --qb:#E2624B;
    --rb:#39B37E;
    --wr:#5590E8;
    --te:#B08CE0;
    --k:#9FB0A4;
    --dst:#C4964E;
    --danger:#E2624B;
    --radius:10px;
    --radius-lg:16px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      repeating-linear-gradient(180deg, rgba(255,255,255,0.014) 0px, rgba(255,255,255,0.014) 1px, transparent 1px, transparent 72px),
      radial-gradient(ellipse 1400px 700px at 50% -10%, #10241A 0%, var(--bg) 60%);
    color:var(--chalk);
    font-family:'Barlow',sans-serif;
    font-size:14.5px;
    line-height:1.5;
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important;}
  }
  a{color:inherit;}
  :focus-visible{outline:2px solid var(--amber-bright); outline-offset:2px; border-radius:4px;}
  .display{font-family:'Anton',sans-serif; letter-spacing:0.02em;}
  .mono{font-family:'Space Mono',monospace;}

  /* ---------- Scoreboard header ---------- */
  .scoreboard{
    background:linear-gradient(180deg,#122419,#0B1A12 88%);
    border-bottom:1px solid var(--line);
    box-shadow:0 1px 0 rgba(0,0,0,0.5), 0 10px 24px -12px rgba(0,0,0,0.6);
    padding:16px 22px 0;
    position:sticky; top:0; z-index:50;
  }
  .scoreboard-inner{
    max-width:1360px; margin:0 auto;
    display:flex; align-items:center; justify-content:space-between;
    gap:18px; flex-wrap:wrap; padding-bottom:14px;
  }
  .brand{display:flex; align-items:center; gap:13px;}
  .brand-mark{
    width:44px;height:44px;border-radius:9px; flex-shrink:0;
    background:linear-gradient(150deg,var(--amber-bright),var(--amber) 55%,#b9840f);
    display:flex;align-items:center;justify-content:center;
    color:var(--ink); font-family:'Anton',sans-serif; font-size:18px; letter-spacing:0.01em;
    box-shadow:0 0 0 1px rgba(0,0,0,0.35), 0 5px 12px -3px rgba(231,169,60,0.4);
  }
  .brand-text h1{
    font-family:'Anton',sans-serif; font-size:20px; margin:0; letter-spacing:0.02em;
    color:var(--chalk); text-wrap:balance;
  }
  .brand-text span{font-size:11px; color:var(--chalk-dim); letter-spacing:0.1em; text-transform:uppercase;}
  .clock{
    display:flex; align-items:stretch; gap:0;
    background:#081410; border:1px solid var(--line); border-radius:11px;
    overflow:hidden; box-shadow:inset 0 1px 0 rgba(255,255,255,0.03), inset 0 -12px 20px -14px rgba(0,0,0,0.6);
  }
  .clock-seg{padding:8px 20px; text-align:center; border-right:1px solid var(--line); min-width:88px;}
  .clock-seg:last-child{border-right:none;}
  .clock-label{font-size:9px; letter-spacing:0.14em; color:var(--chalk-faint); text-transform:uppercase; margin-bottom:3px; font-weight:600;}
  .clock-value{font-family:'Anton',sans-serif; font-size:23px; color:var(--amber-bright); line-height:1.1; text-shadow:0 0 18px rgba(231,169,60,0.3);}
  .clock-value.team{color:var(--chalk); font-family:'Anton',sans-serif; font-size:20px;}
  .clock-value.small{font-size:13px; font-family:'Space Mono',monospace; color:var(--chalk-dim); font-weight:700; line-height:1.7;}
  .admin-zone{display:flex; align-items:center; gap:8px; flex-wrap:wrap;}
  .pill{
    font-size:11.5px; font-weight:600; padding:7px 13px; border-radius:999px; border:1px solid var(--line);
    background:var(--panel); color:var(--chalk-dim); cursor:pointer; letter-spacing:0.02em;
    transition:border-color .15s ease, color .15s ease, background .15s ease;
  }
  .pill:hover{border-color:var(--amber-dim); color:var(--chalk);}
  .pill.active{background:var(--amber); color:var(--ink); border-color:var(--amber); font-weight:700;}
  .pill-solid{background:var(--amber); color:var(--ink); border-color:var(--amber); font-weight:700;}
  .pill-solid:hover{background:var(--amber-bright); border-color:var(--amber-bright); color:var(--ink);}

  .tabbar{
    max-width:1360px; margin:0 auto; padding:0 0;
    display:flex; gap:4px; flex-wrap:wrap;
  }
  .tab{
    font-family:'Anton',sans-serif; font-size:13px; letter-spacing:0.05em;
    padding:10px 18px; border-radius:9px 9px 0 0; cursor:pointer;
    background:transparent; color:var(--chalk-faint); border:1px solid transparent; border-bottom:none;
    text-transform:uppercase; position:relative; top:1px;
  }
  .tab:hover{color:var(--chalk-dim);}
  .tab.active{background:var(--panel-2); color:var(--amber-bright); border-color:var(--line); box-shadow:0 -2px 0 var(--amber) inset;}
  .tab-badge{
    display:none; margin-left:6px; background:var(--amber); color:var(--ink); border-radius:999px;
    padding:1px 7px; font-size:10px; font-family:'Space Mono',monospace; font-weight:700;
  }

  /* ---------- Layout shell ---------- */
  .wrap{max-width:1360px; margin:0 auto; padding:0 22px 64px;}
  .panel{background:var(--panel-2); border:1px solid var(--line); border-top:none; border-radius:0 0 var(--radius-lg) var(--radius-lg); padding:22px;}
  .layout{display:grid; grid-template-columns:1fr 340px; gap:20px; align-items:start;}
  @media (max-width:900px){ .layout{grid-template-columns:1fr;} }

  .section-title{
    font-family:'Anton',sans-serif; font-size:13px; letter-spacing:0.08em; color:var(--chalk-dim);
    text-transform:uppercase; margin:0 0 12px; display:flex; align-items:center; gap:9px;
  }
  .section-title::before{content:''; width:20px; height:2px; background:var(--amber); display:inline-block; flex-shrink:0;}

  /* ---------- Board filters / legend ---------- */
  .filters{display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; align-items:center;}
  .legend{display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin-bottom:16px; padding-bottom:14px; border-bottom:1px solid var(--line-soft);}
  .legend-item{display:flex; align-items:center; gap:6px; font-size:11px; color:var(--chalk-faint); font-weight:600; letter-spacing:0.02em;}
  .legend-dot{width:9px; height:9px; border-radius:3px; flex-shrink:0;}
  .legend-dot.QB{background:var(--qb);} .legend-dot.RB{background:var(--rb);} .legend-dot.WR{background:var(--wr);}
  .legend-dot.TE{background:var(--te);} .legend-dot.K{background:var(--k);} .legend-dot.DST{background:var(--dst);}

  .custom-pick-bar{
    display:flex; gap:8px; flex-wrap:wrap; align-items:center;
    background:var(--panel-3); border:1px dashed var(--amber-dim); border-radius:var(--radius);
    padding:11px 14px; margin-bottom:14px;
  }
  .custom-pick-bar .cp-label{font-size:11px; color:var(--amber-bright); text-transform:uppercase; letter-spacing:0.06em; white-space:nowrap; font-weight:700;}
  .custom-pick-bar input, .custom-pick-bar select{margin:0;}

  .pos-btn{
    border:1px solid var(--line); background:var(--panel); color:var(--chalk-dim);
    font-family:'Space Mono',monospace; font-weight:700; font-size:12px;
    padding:7px 14px; border-radius:7px; cursor:pointer; transition:border-color .15s ease;
  }
  .pos-btn:hover{border-color:var(--chalk-faint);}
  .pos-btn[data-pos="QB"].active{background:var(--qb); border-color:var(--qb); color:#1D0906;}
  .pos-btn[data-pos="RB"].active{background:var(--rb); border-color:var(--rb); color:#052414;}
  .pos-btn[data-pos="WR"].active{background:var(--wr); border-color:var(--wr); color:#04142E;}
  .pos-btn[data-pos="TE"].active{background:var(--te); border-color:var(--te); color:#210F35;}
  .pos-btn[data-pos="K"].active{background:var(--k); border-color:var(--k); color:#10130F;}
  .pos-btn[data-pos="DST"].active{background:var(--dst); border-color:var(--dst); color:#1E1103;}
  .pos-btn[data-pos="ALL"].active{background:var(--amber); border-color:var(--amber); color:var(--ink);}

  .search-input{
    flex:1; min-width:180px;
    background:var(--panel); border:1px solid var(--line); color:var(--chalk);
    padding:8px 13px; border-radius:7px; font-family:'Barlow',sans-serif; font-size:13.5px;
  }
  .search-input::placeholder{color:var(--chalk-faint);}
  select{
    background:var(--panel); border:1px solid var(--line); color:var(--chalk);
    padding:8px 11px; border-radius:7px; font-family:'Barlow',sans-serif; font-size:13px; font-weight:500;
  }

  /* ---------- Player pool table ---------- */
  .ptable-wrap{overflow:auto; max-height:66vh; border:1px solid var(--line-soft); border-radius:var(--radius); background:var(--panel);}
  .ptable{width:100%; border-collapse:collapse;}
  .ptable thead th{
    position:sticky; top:0; z-index:2; background:var(--panel-3);
    text-align:left; font-size:10px; letter-spacing:0.09em; text-transform:uppercase; font-weight:700;
    color:var(--chalk-dim); padding:10px 12px; border-bottom:1px solid var(--line);
  }
  .ptable tbody tr{border-bottom:1px solid var(--line-soft);}
  .ptable tbody tr:last-child{border-bottom:none;}
  .ptable tbody tr:hover{background:rgba(231,169,60,0.05);}
  .ptable td{padding:9px 12px; vertical-align:middle; font-size:13.5px;}
  .ptable tr.drafted{opacity:0.35;}
  .ptable tr.drafted .pname{text-decoration:line-through;}
  .pos-chip{
    display:inline-block; font-family:'Space Mono',monospace; font-weight:700; font-size:10px;
    padding:2px 8px; border-radius:5px; color:#0c1410; letter-spacing:0.02em;
  }
  .pos-chip.QB{background:var(--qb); color:#1D0906;} .pos-chip.RB{background:var(--rb); color:#052414;}
  .pos-chip.WR{background:var(--wr); color:#EAF1FF;} .pos-chip.TE{background:var(--te); color:#210F35;}
  .pos-chip.K{background:var(--k); color:#10130F;} .pos-chip.DST{background:var(--dst); color:#1E1103;}
  .pos-chip.OTHER{background:var(--panel-3); color:var(--chalk-dim); border:1px solid var(--line);}
  .tier-chip{
    display:inline-block; font-family:'Space Mono',monospace; font-size:10px; color:var(--chalk-dim);
    border:1px solid var(--line); padding:1px 6px; border-radius:4px;
  }
  .pname{font-weight:600; color:var(--chalk);}
  .pnotes{font-size:11px; color:var(--chalk-dim); display:block; max-width:340px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .draft-btn{
    font-family:'Space Mono',monospace; font-weight:700; font-size:11px; letter-spacing:0.01em;
    background:var(--amber); color:var(--ink); border:none; padding:7px 12px; border-radius:6px; cursor:pointer;
    white-space:nowrap;
  }
  .draft-btn:hover{background:var(--amber-bright);}
  .draft-btn:disabled{background:var(--panel-3); color:var(--chalk-faint); cursor:not-allowed;}
  .owned-tag{font-size:10.5px; color:var(--chalk-faint); font-family:'Space Mono',monospace;}

  /* ---------- Draft order / up next ---------- */
  .order-list{max-height:78vh; overflow-y:auto; padding-right:4px;}
  .order-list-side{max-height:calc(100vh - 220px); position:sticky; top:172px;}
  .order-row{
    display:flex; align-items:center; gap:9px; padding:8px 10px; border-radius:8px; margin-bottom:3px;
    border:1px solid transparent; font-size:12px;
  }
  .order-row.current{background:rgba(231,169,60,0.14); border-color:var(--amber-dim);}
  .order-row.done{opacity:0.42;}
  .order-num{font-family:'Space Mono',monospace; color:var(--chalk-faint); width:56px; flex-shrink:0; font-size:11px;}
  .order-team{font-weight:700; flex:1; color:var(--chalk); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .order-player{font-size:11px; color:var(--chalk-dim); flex-shrink:0; text-align:right; max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .order-traded{font-size:9px; color:var(--amber-bright); margin-left:5px; font-family:'Space Mono',monospace; font-weight:700;}

  /* ---------- Buttons / general ---------- */
  .btn{
    font-family:'Barlow',sans-serif; font-weight:600; font-size:13.5px;
    padding:9px 17px; border-radius:8px; border:1px solid var(--line); background:var(--panel);
    color:var(--chalk); cursor:pointer; transition:border-color .15s ease, background .15s ease;
  }
  .btn:hover{border-color:var(--chalk-faint);}
  .btn.primary{background:var(--amber); color:var(--ink); border-color:var(--amber); font-weight:700;}
  .btn.primary:hover{background:var(--amber-bright);}
  .btn.danger{background:transparent; border-color:var(--danger); color:var(--danger);}
  .btn.danger:hover{background:rgba(226,98,75,0.1);}
  .btn:disabled{opacity:0.4; cursor:not-allowed;}
  .btn-row{display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px;}

  /* ---------- Trades ---------- */
  .trade-card{
    background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:14px 16px; margin-bottom:10px;
  }
  .trade-title{font-family:'Space Mono',monospace; font-size:12.5px; font-weight:700; color:var(--amber-bright); margin-bottom:7px; display:flex; align-items:center;}
  .trade-flow{font-size:12.5px; color:var(--chalk-dim); line-height:1.65;}
  .trade-note{font-size:11.5px; color:var(--chalk-faint); font-style:italic; margin-top:5px;}
  .pick-checks{display:flex; flex-wrap:wrap; gap:6px; margin-top:6px;}
  .pick-check{
    font-family:'Space Mono',monospace; font-size:11px; font-weight:700; border:1px solid var(--line); border-radius:5px;
    padding:5px 9px; cursor:pointer; color:var(--chalk-dim); background:var(--panel-3);
    transition:border-color .15s ease;
  }
  .pick-check:hover{border-color:var(--amber-dim);}
  .pick-check.sel{background:var(--amber); color:var(--ink); border-color:var(--amber);}
  .form-row{display:flex; gap:12px; flex-wrap:wrap; margin-bottom:12px;}
  label{font-size:10.5px; color:var(--chalk-faint); text-transform:uppercase; letter-spacing:0.07em; font-weight:700; display:block; margin-bottom:5px;}

  /* ---------- Rosters ---------- */
  .roster-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(270px,1fr)); gap:14px;}
  .roster-card{background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:14px;}
  .roster-card h3{font-family:'Anton',sans-serif; font-size:15px; margin:0 0 9px; color:var(--chalk); display:flex; align-items:baseline; letter-spacing:0.01em;}
  .roster-card .rcount{font-size:10px; color:var(--chalk-faint); font-family:'Space Mono',monospace; margin-left:7px; font-weight:400;}
  .roster-row{display:flex; justify-content:space-between; align-items:center; gap:8px; font-size:12.5px; padding:5px 0; border-bottom:1px solid var(--line-soft);}
  .roster-row:last-child{border-bottom:none;}
  .roster-row .nm{color:var(--chalk);}
  .roster-row .pk{color:var(--chalk-faint); font-family:'Space Mono',monospace; font-size:10px; flex-shrink:0;}

  .empty-hint{color:var(--chalk-faint); font-size:12.5px; padding:16px; text-align:center;}

  .toast{
    position:fixed; bottom:20px; right:20px; background:var(--panel-3); border:1px solid var(--amber-dim);
    color:var(--chalk); padding:11px 17px; border-radius:9px; font-size:13px; z-index:200;
    box-shadow:0 12px 30px rgba(0,0,0,0.5); max-width:320px;
  }
  ::-webkit-scrollbar{width:9px; height:9px;}
  ::-webkit-scrollbar-thumb{background:var(--line); border-radius:5px;}
  ::-webkit-scrollbar-thumb:hover{background:var(--chalk-faint);}
  ::-webkit-scrollbar-track{background:transparent;}

  .footer-note{color:var(--chalk-faint); font-size:11px; text-align:center; padding:22px 0 0; line-height:1.6;}

  /* ---------- Modal ---------- */
  .modal-bg{position:fixed; inset:0; background:rgba(4,10,6,0.78); display:none; align-items:center; justify-content:center; z-index:500; padding:16px; backdrop-filter:blur(2px);}
  .modal-bg.open{display:flex;}
  .modal{background:var(--panel-2); border:1px solid var(--line); border-radius:var(--radius-lg); padding:24px; width:100%; max-width:340px; box-shadow:0 24px 60px rgba(0,0,0,0.55);}
  .modal h3{font-family:'Anton',sans-serif; margin:0 0 9px; font-size:18px; letter-spacing:0.02em; color:var(--chalk);}
  .modal p{font-size:12.5px; color:var(--chalk-dim); margin:0 0 14px; line-height:1.55;}
  .modal input, .modal-select{width:100%; padding:11px 13px; border-radius:8px; border:1px solid var(--line); background:var(--panel); color:var(--chalk); margin-bottom:15px; font-family:'Space Mono',monospace; font-size:14px;}
  .modal-select{font-family:'Barlow',sans-serif; font-size:14px; font-weight:500;}
  .modal-actions{display:flex; gap:8px; justify-content:flex-end; align-items:center;}
</style>
</head>
<body>
<div id="loadingOverlay" style="position:fixed; inset:0; z-index:900; background:var(--bg); color:var(--chalk-dim); display:flex; align-items:center; justify-content:center; font-family:'Barlow',sans-serif; font-size:14px; letter-spacing:0.02em;">Loading draft board…</div>
<div class="scoreboard">
  <div class="scoreboard-inner">
    <div class="brand">
      <div class="brand-mark">AΕΠ</div>
      <div class="brand-text">
        <h1>AEPi Fantasy Draft</h1>
        <span id="seasonTag">2026 Season · 12 Teams · 16 Rounds</span>
      </div>
    </div>
    <div class="clock">
      <div class="clock-seg">
        <div class="clock-label">On the Clock</div>
        <div class="clock-value team" id="clockTeam">—</div>
      </div>
      <div class="clock-seg">
        <div class="clock-label">Pick</div>
        <div class="clock-value" id="clockPick">—</div>
      </div>
      <div class="clock-seg">
        <div class="clock-label">Round</div>
        <div class="clock-value small" id="clockRound">—</div>
      </div>
    </div>
    <div class="admin-zone">
      <button class="pill pill-solid" id="advanceBtn" data-action="advance-pick" style="display:none;">Next Pick →</button>
      <span class="pill" id="myTeamPill" data-action="claim-team">🏷 Set your team</span>
      <span class="pill" data-action="refresh-now" title="Updates arrive automatically — this is just a manual page reload, rarely needed">⟳ Reload</span>
      <span class="pill" id="adminPill" data-action="toggle-admin">🔒 Admin</span>
      <span class="pill" id="pinPill" data-action="change-pin" style="display:none;">Set PIN</span>
      <span class="pill" data-action="export">⬇ Export</span>
    </div>
  </div>
  <div class="tabbar">
    <div class="tab active" data-tab="board" data-action="tab">Board</div>
    <div class="tab" data-tab="order" data-action="tab">Draft Order</div>
    <div class="tab" data-tab="trades" data-action="tab">Trade Center<span id="pendingBadge" class="tab-badge"></span></div>
    <div class="tab" data-tab="rosters" data-action="tab">Rosters</div>
  </div>
</div>
<div class="wrap">
  <div class="panel" id="tab-board">
    <div class="layout">
      <div>
        <div class="section-title">Player Pool</div>
        <div class="filters">
          <button class="pos-btn active" data-pos="ALL" data-action="setpos">ALL</button>
          <button class="pos-btn" data-pos="QB" data-action="setpos">QB</button>
          <button class="pos-btn" data-pos="RB" data-action="setpos">RB</button>
          <button class="pos-btn" data-pos="WR" data-action="setpos">WR</button>
          <button class="pos-btn" data-pos="TE" data-action="setpos">TE</button>
          <button class="pos-btn" data-pos="K" data-action="setpos">K</button>
          <button class="pos-btn" data-pos="DST" data-action="setpos">DST</button>
          <input class="search-input" id="searchBox" placeholder="Search players or NFL team…">
          <select id="hideDrafted">
            <option value="hide">Hide drafted</option>
            <option value="show">Show drafted</option>
          </select>
        </div>
        <div class="legend">
          <span class="legend-item"><span class="legend-dot QB"></span>QB</span>
          <span class="legend-item"><span class="legend-dot RB"></span>RB</span>
          <span class="legend-item"><span class="legend-dot WR"></span>WR</span>
          <span class="legend-item"><span class="legend-dot TE"></span>TE</span>
          <span class="legend-item"><span class="legend-dot K"></span>K</span>
          <span class="legend-item"><span class="legend-dot DST"></span>DST</span>
        </div>
        <div id="customPickBar" style="display:none;"></div>
        <div class="ptable-wrap">
        <table class="ptable">
          <thead><tr>
            <th>Player</th><th>Pos</th><th>NFL Team</th><th></th>
          </tr></thead>
          <tbody id="boardBody"></tbody>
        </table>
        </div>
      </div>
      <div>
        <div class="section-title">Up Next</div>
