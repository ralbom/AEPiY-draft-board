function renderCustomPickBar(onClockTeam, idx){
  const bar = document.getElementById("customPickBar");
  if(!isAdmin || idx===-1){
    bar.style.display = "none";
    _customBarTeam = undefined;
    return;
  }
  bar.style.display = "flex";
  bar.className = "custom-pick-bar";
  const needsFullBuild = (_customBarTeam !== onClockTeam) || !bar.querySelector('#customName');
  if(needsFullBuild){
    bar.innerHTML =
      '<span class="cp-label">Off-board pick →</span>'+
      '<input class="search-input" id="customName" placeholder="Player name" style="flex:1; min-width:140px;">'+
      '<select id="customPos">'+
        '<option value="QB">QB</option><option value="RB">RB</option><option value="WR">WR</option>'+
        '<option value="TE">TE</option><option value="K">K</option><option value="DST">DST</option>'+
        '<option value="OTHER" selected>Other</option>'+
      '</select>'+
      '<button class="draft-btn" data-action="draft-custom">Draft to '+(onClockTeam||"—")+'</button>';
    _customBarTeam = onClockTeam;
  }
}
async function submitCustomPick(){
  if(!isAdmin){ toast("Admin only."); return; }
  const nameEl = document.getElementById("customName");
  const posEl = document.getElementById("customPos");
  if(!nameEl) return;
  const name = nameEl.value.trim();
  if(!name){ toast("Type the player's name first."); return; }
  const order = effectiveOrder();
  const idx = currentPickIndex(order);
  if(idx===-1){ toast("Draft is already complete."); return; }
  const pick = order[idx];
  const customId = "c"+Date.now()+Math.floor(Math.random()*1000);
  const player = {id: customId, name, pos: posEl.value, nflTeam:"", tier:6, custom:true};
  state.customPlayers = (state.customPlayers||[]).concat([player]);
  state.draftedPicks[pick.overall] = {playerId: customId, team: pick.effTeam, ts: Date.now()};
  await publishState();
  renderAll();
  toast(name+" drafted to "+pick.effTeam+".");
}
function orderRowHtml(p, isCurrent, isDone){
  const pick = state.draftedPicks[p.overall];
  let playerName = "";
  if(pick){
    if(pick.skipped) playerName = "(advanced — no player logged)";
    else playerName = (findPlayer(pick.playerId)||{}).name || "";
  }
  return '<div class="order-row '+(isCurrent?'current':'')+' '+(pick?'done':'')+'">'+
    '<span class="order-num">R'+p.wave+' · #'+p.overall+'</span>'+
    '<span class="order-team">'+p.effTeam+(p.traded?'<span class="order-traded">TRD</span>':'')+'</span>'+
    '<span class="order-player">'+(playerName ? escapeHtml(playerName) : (isCurrent?'on the clock':''))+'</span>'+
  '</div>';
}
/* ================= RENDER: FULL ORDER TAB ================= */
function renderFullOrder(){
  const order = effectiveOrder();
  const idx = currentPickIndex(order);
  const el = document.getElementById("fullOrder");
  el.innerHTML = order.map((p,i)=> orderRowHtml(p, i===idx, !!state.draftedPicks[p.overall])).join("");
}
/* ================= RENDER: TRADES TAB (open to everyone) ================= */
function renderTrades(){
  const origEl = document.getElementById("origTrades");
  origEl.innerHTML = ORIGINAL_TRADES.map(t=>{
    return '<div class="trade-card"><div class="trade-title">'+t.sender+' &harr; '+t.receiver+'</div>'+
      '<div class="trade-flow">'+t.sender+' sends '+t.sent.join(", ")+' &rarr; receives '+t.received.join(", ")+'</div>'+
      (t.note? '<div class="trade-note">"'+escapeHtml(t.note)+'"</div>' : '')+
    '</div>';
  }).join("");
  const order = effectiveOrder();
  const undraftedByTeam = {};
  OWNERS.forEach(o=> undraftedByTeam[o]=[]);
  order.forEach(p=>{ if(!state.draftedPicks[p.overall]) undraftedByTeam[p.effTeam].push(p); });
  window._undraftedByTeam = undraftedByTeam;
  if(!tradeSelA.team && myTeam && OWNERS.includes(myTeam)) tradeSelA.team = myTeam;
  const formEl = document.getElementById("liveTradeForm");
  const prevNoteEl = document.getElementById("tradeNote");
  const prevNote = prevNoteEl ? prevNoteEl.value : "";
  formEl.innerHTML =
    '<div class="trade-card">'+
    '<div class="form-row">'+
      '<div><label>Team A</label><select id="teamA" data-action="team-select" data-which="A">'+teamOptions(tradeSelA.team)+'</select></div>'+
      '<div><label>Team B</label><select id="teamB" data-action="team-select" data-which="B">'+teamOptions(tradeSelB.team)+'</select></div>'+
    '</div>'+
    '<label>Picks Team A sends to B</label>'+
    '<div class="pick-checks" id="picksA"></div>'+
    '<label style="margin-top:8px; display:block;">Picks Team B sends to A</label>'+
    '<div class="pick-checks" id="picksB"></div>'+
    '<div class="form-row" style="margin-top:10px;">'+
      '<div style="flex:1;"><label>Note (optional)</label><input class="search-input" id="tradeNote" placeholder="e.g. moving up for a QB"></div>'+
    '</div>'+
    '<button class="btn primary" data-action="submit-trade">Record Trade</button>'+
    '<div class="trade-note" style="margin-top:8px;">'+(isAdmin ? 'As admin, trades you record are approved immediately.' : 'Any team can propose a trade here — it takes effect once the admin approves it.')+' Only undrafted picks are tradeable.</div>'+
    '</div>';
  const newNoteEl = document.getElementById("tradeNote");
  if(newNoteEl && prevNote) newNoteEl.value = prevNote;
  renderPickChecks();
  const pending = state.liveTrades.filter(t=> t.status==='pending');
  const approved = state.liveTrades.filter(t=> t.status==='approved' || !t.status);
  const rejected = state.liveTrades.filter(t=> t.status==='rejected');
  const pendingEl = document.getElementById("pendingTrades");
  if(pendingEl){
    if(pending.length===0){
      pendingEl.innerHTML = '<div class="empty-hint">No trades waiting on approval.</div>';
    } else {
      pendingEl.innerHTML = pending.slice().reverse().map(t=> tradeCardHtml(t, true)).join("");
    }
  }
  const liveEl = document.getElementById("liveTrades");
  const approvedAndRejected = approved.slice().reverse().concat(rejected.slice().reverse());
  if(approvedAndRejected.length===0){
    liveEl.innerHTML = '<div class="empty-hint">No live trades recorded yet this draft.</div>';
  } else {
    liveEl.innerHTML = approvedAndRejected.map(t=> tradeCardHtml(t, false)).join("");
  }
}
function tradeCardHtml(t, showApproveReject){
  const statusBadge = t.status==='rejected'
    ? '<span style="color:var(--danger); font-size:10px; font-family:\'Space Mono\',monospace; margin-left:6px;">REJECTED</span>'
    : (t.status==='pending' ? '<span style="color:var(--amber); font-size:10px; font-family:\'Space Mono\',monospace; margin-left:6px;">PENDING</span>' : '');
  const adminActions = isAdmin
    ? (showApproveReject
        ? ' <span style="float:right;">'+
            '<span style="cursor:pointer; color:var(--amber); margin-right:10px;" data-action="approve-trade" data-id="'+t.id+'">approve</span>'+
            '<span style="cursor:pointer; color:var(--danger);" data-action="reject-trade" data-id="'+t.id+'">reject</span>'+
          '</span>'
        : ' <span style="float:right; cursor:pointer; color:var(--danger);" data-action="remove-trade" data-id="'+t.id+'">remove</span>')
    : '';
  const cardStyle = t.status==='rejected' ? ' style="opacity:0.5;"' : '';
  const proposedByLine = t.proposedBy
    ? '<div class="trade-note" style="opacity:0.8;">Proposed by '+escapeHtml(t.proposedBy)+'</div>'
    : '';
  return '<div class="trade-card"'+cardStyle+'>'+
    '<div class="trade-title">'+t.teamA+' &harr; '+t.teamB+statusBadge+adminActions+'</div>'+
    '<div class="trade-flow">'+t.teamA+' sends #'+t.picksA.join(", #")+' &rarr; receives #'+t.picksB.join(", #")+'</div>'+
    proposedByLine+
    (t.note? '<div class="trade-note">"'+escapeHtml(t.note)+'"</div>' : '')+
  '</div>';
}
function teamOptions(selected){
  return '<option value="">Select…</option>'+OWNERS.map(o=> '<option value="'+o+'" '+(o===selected?'selected':'')+'>'+o+'</option>').join("");
}
function onTeamSelect(which){
  const val = document.getElementById("team"+which).value;
  if(which==='A'){ tradeSelA.team=val; tradeSelA.picks=new Set(); }
  else { tradeSelB.team=val; tradeSelB.picks=new Set(); }
  renderPickChecks();
}
function renderPickChecks(){
  const a = document.getElementById("picksA");
  const b = document.getElementById("picksB");
  if(!a || !b) return;
  const listA = tradeSelA.team ? (window._undraftedByTeam[tradeSelA.team]||[]) : [];
  const listB = tradeSelB.team ? (window._undraftedByTeam[tradeSelB.team]||[]) : [];
  a.innerHTML = listA.length ? listA.map(p=> pickCheckHtml(p, tradeSelA.picks, 'A')).join("") : '<span class="empty-hint">Select Team A</span>';
  b.innerHTML = listB.length ? listB.map(p=> pickCheckHtml(p, tradeSelB.picks, 'B')).join("") : '<span class="empty-hint">Select Team B</span>';
}
function pickCheckHtml(p, set, which){
  const sel = set.has(p.overall);
  return '<span class="pick-check '+(sel?'sel':'')+'" data-action="toggle-pick" data-ov="'+p.overall+'" data-which="'+which+'">R'+p.wave+' #'+p.overall+'</span>';
}
function togglePick(ov, which){
  const set = which==='A' ? tradeSelA.picks : tradeSelB.picks;
  set.has(ov) ? set.delete(ov) : set.add(ov);
  renderPickChecks();
}
async function submitTrade(){
  if(!tradeSelA.team || !tradeSelB.team || tradeSelA.team===tradeSelB.team){
    toast("Pick two different teams."); return;
  }
  if(tradeSelA.picks.size===0 && tradeSelB.picks.size===0){
    toast("Select at least one pick to swap."); return;
  }
  const noteEl = document.getElementById("tradeNote");
  const note = noteEl ? noteEl.value.trim() : "";
  const status = isAdmin ? "approved" : "pending";
  const newTrade = {
    id: 't'+Date.now()+'_'+Math.random().toString(36).slice(2,8),
    teamA: tradeSelA.team, picksA: Array.from(tradeSelA.picks),
    teamB: tradeSelB.team, picksB: Array.from(tradeSelB.picks),
    note, ts: Date.now(), status, proposedBy: myTeam || null
  };
  tradeSelA = {team:null, picks:new Set()};
  tradeSelB = {team:null, picks:new Set()};
  state.liveTrades.push(newTrade);
  const result = await publishState();
  if(result.ok){
    toast(status==='approved' ? "Trade recorded." : "Trade submitted — waiting on admin approval.");
  } else {
    toast("Trade may not have saved — check your connection and try again.");
  }
  renderAll();
}
async function approveTrade(id){
  if(!isAdmin) return;
  const t = state.liveTrades.find(x=>x.id===id);
  if(!t) return;
  t.status = "approved";
  await publishState();
  renderAll();
  toast("Trade approved.");
}
async function rejectTrade(id){
  if(!isAdmin) return;
  const t = state.liveTrades.find(x=>x.id===id);
  if(!t) return;
  t.status = "rejected";
  await publishState();
  renderAll();
  toast("Trade rejected.");
}
async function removeTrade(id){
  if(!isAdmin) return;
  state.liveTrades = state.liveTrades.filter(t=>t.id!==id);
  await publishState();
  renderAll();
}
/* ================= RENDER: ROSTERS ================= */
function renderRosters(){
  const grid = document.getElementById("rosterGrid");
  const byTeam = {};
  OWNERS.forEach(o=> byTeam[o]=[]);
  Object.entries(state.draftedPicks).forEach(([ov,d])=>{
    if(!byTeam[d.team]) byTeam[d.team]=[];
    const player = d.playerId ? findPlayer(d.playerId) : null;
    byTeam[d.team].push({ov, player, skipped: !!d.skipped});
  });
  grid.innerHTML = OWNERS.map(team=>{
    const roster = (byTeam[team]||[]).sort((a,b)=> a.ov-b.ov);
    return '<div class="roster-card"><h3>'+team+'<span class="rcount">'+roster.length+' picks</span></h3>'+
      (roster.length===0 ? '<div class="empty-hint">No picks yet</div>' :
        roster.map(r=> r.player
          ? '<div class="roster-row"><span class="nm">'+escapeHtml(r.player.name)+' <span class="pos-chip '+r.player.pos+'" style="font-size:9px;">'+r.player.pos+'</span></span><span class="pk">#'+r.ov+'</span></div>'
          : '<div class="roster-row"><span class="nm" style="color:var(--chalk-dim); font-style:italic;">(advanced — no player logged)</span><span class="pk">#'+r.ov+'</span></div>'
        ).join("")
      )+
    '</div>';
  }).join("");
}
/* ================= ACTIONS ================= */
async function draftPlayer(playerId){
  if(!isAdmin){ toast("Admin only — unlock admin to draft players."); return; }
  const order = effectiveOrder();
  const idx = currentPickIndex(order);
  if(idx===-1){ toast("Draft is already complete."); return; }
  if(draftedPlayerIds().has(playerId)){ toast("Player already drafted."); return; }
  const pick = order[idx];
  state.draftedPicks[pick.overall] = {playerId, team: pick.effTeam, ts: Date.now()};
  await publishState();
  renderAll();
}
async function advancePick(){
  if(!isAdmin){ toast("Admin only."); return; }
  const order = effectiveOrder();
  const idx = currentPickIndex(order);
  if(idx===-1){ toast("Draft is already complete."); return; }
  const pick = order[idx];
  state.draftedPicks[pick.overall] = {playerId: null, team: pick.effTeam, ts: Date.now(), skipped:true};
  await publishState();
  renderAll();
  toast("Advanced past pick #"+pick.overall+" (no player logged).");
}
async function undoLastPick(){
  if(!isAdmin){ toast("Admin only."); return; }
  const keys = Object.keys(state.draftedPicks).map(Number).sort((a,b)=>a-b);
  if(keys.length===0){ toast("Nothing to undo."); return; }
  const last = keys[keys.length-1];
  delete state.draftedPicks[last];
  await publishState();
  renderAll();
  toast("Undid pick #"+last+".");
}
async function resetDraft(){
  if(!isAdmin){ toast("Admin only."); return; }
  const ok1 = await showModal({
    title:"Reset entire draft?",
    message:"This clears every pick and every live trade, for everyone, right now.",
    confirmLabel:"Yes, reset"
  });
  if(!ok1) return;
  const ok2 = await showModal({
    title:"Are you absolutely sure?",
    message:"This cannot be undone.",
    confirmLabel:"Reset everything"
  });
  if(!ok2) return;
  state.draftedPicks = {};
  state.liveTrades = [];
  await publishState();
  renderAll();
  toast("Draft reset.");
}
/* ================= EXPORT ================= */
function exportExcel(){
  const order = effectiveOrder();
  const results = order.map(p=>{
    const d = state.draftedPicks[p.overall];
    const player = d ? findPlayer(d.playerId) : null;
    return {
      Overall: p.overall,
      Round: p.wave,
      "Pick in Round": ((p.overall-1)%12)+1,
      Team: p.effTeam,
      "Original Slot": p.team,
      Traded: p.traded ? "Y":"N",
      Player: player ? player.name : "",
      Pos: player ? player.pos : "",
      "NFL Team": player ? player.nflTeam : "",
      "Drafted At": d ? new Date(d.ts).toLocaleString() : ""
    };
  });
  const rosterRows = [];
  OWNERS.forEach(team=>{
    Object.entries(state.draftedPicks).filter(([ov,d])=>d.team===team).sort((a,b)=>a[0]-b[0]).forEach(([ov,d])=>{
      const player = findPlayer(d.playerId);
      rosterRows.push({Team:team, Pick:ov, Player:player?player.name:"", Pos:player?player.pos:"", "NFL Team":player?player.nflTeam:""});
    });
  });
  const tradeRows = [];
  ORIGINAL_TRADES.forEach(t=> tradeRows.push({Type:"Original", TeamA:t.sender, Sent:t.sent.join(", "), TeamB:t.receiver, Received:t.received.join(", "), Note:t.note}));
  state.liveTrades.forEach(t=> tradeRows.push({Type:"Live", TeamA:t.teamA, Sent:t.picksA.join(", "), TeamB:t.teamB, Received:t.picksB.join(", "), Note:t.note}));
  if(typeof XLSX === "undefined"){ toast("Export library still loading — try again in a moment."); return; }
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(results), "Draft Results");
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rosterRows), "Rosters");
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(tradeRows), "Trade Log");
  XLSX.writeFile(wb, "AEPi_2026_Draft_Results.xlsx");
  toast("Excel file downloading…");
}
/* ================= UTIL ================= */
function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}
let toastTimer;
function toast(msg){
  let el = document.getElementById("toastEl");
  if(!el){
    el = document.createElement("div");
    el.id = "toastEl"; el.className = "toast";
    document.body.appendChild(el);
  }
  el.textContent = msg;
  el.style.display = "block";
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=> el.style.display="none", 3200);
}
function renderAll(){
  if(!state) return; // first Firestore snapshot hasn't arrived yet
  renderClock();
  renderPendingBadge();
  if(currentTab==='board') renderBoard();
  if(currentTab==='order') renderFullOrder();
  if(currentTab==='trades') renderTrades();
  if(currentTab==='rosters') renderRosters();
}
function renderPendingBadge(){
  const badge = document.getElementById("pendingBadge");
  if(!badge) return;
  const count = (state.liveTrades||[]).filter(t=>t.status==='pending').length;
  if(count>0){
    badge.style.display = "inline-block";
    badge.textContent = count;
  } else {
    badge.style.display = "none";
  }
}
/* ================= MODAL (replaces prompt/confirm — sandboxed iframes often block those) ================= */
let _modalResolve = null;
let _modalHasInput = false;
let _modalHasSelect = false;
function showModal({title, message, withInput=false, placeholder='', confirmLabel='Confirm', options=null, showSkip=false}){
  return new Promise(resolve=>{
    _modalResolve = resolve;
    _modalHasInput = withInput;
    _modalHasSelect = !!options;
    document.getElementById('modalTitle').textContent = title || '';
    const msgEl = document.getElementById('modalMsg');
    msgEl.textContent = message || '';
    msgEl.style.display = message ? 'block' : 'none';
    const inp = document.getElementById('modalInput');
    const sel = document.getElementById('modalSelect');
    if(options){
      sel.innerHTML = options.map(o=>'<option value="'+o+'">'+o+'</option>').join('');
      sel.style.display = 'block';
      inp.style.display = 'none';
    } else {
      sel.style.display = 'none';
      inp.style.display = withInput ? 'block' : 'none';
      inp.value = '';
      inp.placeholder = placeholder || '';
      inp.type = withInput ? 'password' : 'text';
    }
    document.getElementById('modalConfirmBtn').textContent = confirmLabel || 'Confirm';
    document.getElementById('modalSkip').style.display = showSkip ? 'inline' : 'none';
    document.getElementById('modalBg').classList.add('open');
    if(withInput) setTimeout(()=> inp.focus(), 60);
  });
}
function closeModal(result){
  document.getElementById('modalBg').classList.remove('open');
  if(_modalResolve){
    const r = _modalResolve;
    _modalResolve = null;
    r(result);
  }
}
function confirmModal(){
  if(_modalHasSelect){
    closeModal(document.getElementById('modalSelect').value);
  } else if(_modalHasInput){
    const val = document.getElementById('modalInput').value;
    closeModal(val);
  } else {
    closeModal(true);
  }
}
function cancelModal(){
  closeModal((_modalHasInput || _modalHasSelect) ? null : false);
}
function skipModal(){
  closeModal('__SKIP__');
}
/* ================= EVENT DELEGATION (CSP-safe, no inline handlers) ================= */
document.addEventListener('click', function(e){
  const el = e.target.closest('[data-action]');
  if(!el) return;
  try{
    const action = el.dataset.action;
    if(action === 'tab') setTab(el.dataset.tab);
    else if(action === 'setpos') setPos(el.dataset.pos);
    else if(action === 'toggle-admin') toggleAdmin();
    else if(action === 'change-pin') changePin();
    else if(action === 'export') exportExcel();
    else if(action === 'undo') undoLastPick();
    else if(action === 'reset') resetDraft();
    else if(action === 'draft') draftPlayer(parseInt(el.dataset.id,10));
    else if(action === 'draft-custom') submitCustomPick();
    else if(action === 'advance-pick') advancePick();
    else if(action === 'toggle-pick') togglePick(parseInt(el.dataset.ov,10), el.dataset.which);
    else if(action === 'submit-trade') submitTrade();
    else if(action === 'approve-trade') approveTrade(el.dataset.id);
    else if(action === 'reject-trade') rejectTrade(el.dataset.id);
    else if(action === 'remove-trade') removeTrade(el.dataset.id);
    else if(action === 'modal-confirm') confirmModal();
    else if(action === 'modal-cancel') cancelModal();
    else if(action === 'modal-skip') skipModal();
    else if(action === 'claim-team') claimTeam();
    else if(action === 'refresh-now') refreshBoard();
  }catch(err){
    console.error(err);
    toast("Something went wrong: "+err.message);
  }
});
// click on the dimmed backdrop (but not the modal box itself) cancels
document.getElementById('modalBg') && document.getElementById('modalBg').addEventListener('click', function(e){
  if(e.target.id === 'modalBg') cancelModal();
});
document.addEventListener('keydown', function(e){
  const bg = document.getElementById('modalBg');
  if(!bg || !bg.classList.contains('open')) return;
  if(e.key === 'Enter') confirmModal();
  else if(e.key === 'Escape') cancelModal();
});
document.addEventListener('change', function(e){
  const el = e.target;
  if(el.id === 'hideDrafted') renderBoard();
  else if(el.dataset && el.dataset.action === 'team-select') onTeamSelect(el.dataset.which);
});
document.addEventListener('input', function(e){
  if(e.target.id === 'searchBox') renderBoard();
});
// Restore this tab's small UI memory (active tab, position filter, admin
// unlock) before the first paint. The board itself stays blank/loading
// until Firestore's first snapshot lands (renderBoard/renderAll no-op on
// state===null), so it's safe to set these up immediately.
restoreUiState();
setPos(currentPos);
setTab(currentTab);
initFirebase();
loadMyTeam().then(neverAsked=>{
  if(neverAsked){
    // small delay so it doesn't compete with the initial paint/board load
    setTimeout(()=>{ claimTeam(); }, 600);
  }
});
