/* ================= PERSISTENCE =================
   Real-time shared state via Firestore: one document holds the whole
   mutable board (drafted picks, live trades, custom players, admin PIN).
   Every open tab subscribes with onSnapshot, so a write from ANY device
   reaches every other open tab in well under a second -- no publish/reload
   cycle, no pinned-version staleness, no polling. Writes are last-write-wins
   (fine for a friendly draft with a handful of concurrent editors); if this
   ever needs to be airtight under heavy concurrent writes, swap publishState
   for a Firestore transaction (runTransaction) instead. */
let db = null;
let stateRef = null;
function initFirebase(){
  try{
    firebase.initializeApp(firebaseConfig);
    db = firebase.firestore();
    stateRef = db.collection("draft").doc("state");
  }catch(e){
    console.error("Firebase init failed", e);
    toast("Couldn't connect to the live board — check firebaseConfig.");
    return;
  }
  stateRef.onSnapshot(
    snap => {
      if(snap.exists){
        state = snap.data();
      } else {
        // first-ever load for this project: seed the document
        state = Object.assign({}, DEFAULT_STATE);
        stateRef.set(state).catch(e=> console.error("seed failed", e));
      }
      const overlay = document.getElementById("loadingOverlay");
      if(overlay) overlay.remove();
      renderAll();
    },
    err => {
      console.error("onSnapshot error", err);
      toast("Lost connection to the live board — check your Firestore rules.");
    }
  );
}
// Push the current in-memory `state` to everyone. Firestore's onSnapshot
// fires for this tab too (from local cache, near-instantly) as well as
// every other open tab, so callers don't need to call renderAll() themselves
// after this resolves -- it's harmless if they do (renderAll() is cheap).
async function publishState(){
  if(!stateRef){
    toast("Not connected to the live board yet — try again in a moment.");
    return {ok:false};
  }
  try{
    await stateRef.set(state);
    return {ok:true};
  }catch(e){
    console.error("publish failed", e);
    toast("Couldn't save your change — check your connection and try again.");
    return {ok:false, error:e};
  }
}
