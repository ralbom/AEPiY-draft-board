}
/* ================= DERIVED ORDER ================= */
function effectiveOrder(){
  const owner = {};
  BASE_ORDER.forEach(p=> owner[p.overall] = p.team);
  state.liveTrades.filter(t=> t.status==='approved' || !t.status).forEach(t=>{
    t.picksA.forEach(ov => owner[ov] = t.teamB);
    t.picksB.forEach(ov => owner[ov] = t.teamA);
  });
  return BASE_ORDER.map(p=> Object.assign({}, p, {
    effTeam: owner[p.overall],
    traded: owner[p.overall] !== p.team
  }));
}
function currentPickIndex(order){
  for(let i=0;i<order.length;i++){
    if(!state.draftedPicks[order[i].overall]) return i;
  }
  return -1;
}
function draftedPlayerIds(){
  return new Set(Object.values(state.draftedPicks).map(d=>d.playerId));
}
function findPlayer(id){
  if(id===null || id===undefined) return null;
  return PLAYERS.find(p=>p.id===id) || (state.customPlayers||[]).find(p=>p.id===id) || null;
}
