/* ================= RENDER: SCOREBOARD ================= */
function renderClock(){
  const order = effectiveOrder();
  const idx = currentPickIndex(order);
  const advanceBtn = document.getElementById("advanceBtn");
  if(idx === -1){
    document.getElementById("clockTeam").textContent = "DRAFT COMPLETE";
    document.getElementById("clockPick").textContent = "✓";
    document.getElementById("clockRound").textContent = order.length+" / "+order.length;
    advanceBtn.style.display = "none";
  } else {
    const pick = order[idx];
    document.getElementById("clockTeam").textContent = pick.effTeam;
    document.getElementById("clockPick").textContent = "#"+pick.overall;
    document.getElementById("clockRound").textContent = "Round "+pick.wave+" · Pick "+(((pick.overall-1)%12)+1);
    advanceBtn.style.display = isAdmin ? "inline-block" : "none";
  }
  document.getElementById("adminPill").textContent = isAdmin ? "🔓 Admin" : "🔒 Admin";
  document.getElementById("adminPill").classList.toggle("active", isAdmin);
  document.getElementById("pinPill").style.display = isAdmin ? "inline-block" : "none";
}
/* ================= RENDER: BOARD ================= */
function renderBoard(){
  if(!state) return; // first Firestore snapshot hasn't arrived yet
  const order = effectiveOrder();
  const idx = currentPickIndex(order);
  const onClockTeam = idx>=0 ? order[idx].effTeam : null;
  renderCustomPickBar(onClockTeam, idx);
  const drafted = draftedPlayerIds();
  const searchEl = document.getElementById("searchBox");
  const hideEl = document.getElementById("hideDrafted");
  const q = (searchEl.value || "").toLowerCase();
  const hideDraftedSel = hideEl.value === "hide";
  let list = PLAYERS.filter(p=>{
    if(currentPos !== "ALL" && p.pos !== currentPos) return false;
    if(q && !(p.name.toLowerCase().includes(q) || (p.nflTeam||"").toLowerCase().includes(q))) return false;
    if(hideDraftedSel && drafted.has(p.id)) return false;
    return true;
  });
  list.sort((a,b)=> a.tier-b.tier || a.name.localeCompare(b.name));
  const body = document.getElementById("boardBody");
  if(list.length===0){
    body.innerHTML = '<tr><td colspan="4" class="empty-hint">No players match your filters.</td></tr>';
  } else {
    body.innerHTML = list.map(p=>{
      const isDrafted = drafted.has(p.id);
      let ownerTag = "";
      if(isDrafted){
        const entry = Object.entries(state.draftedPicks).find(([ov,d])=> d.playerId===p.id);
        if(entry) ownerTag = '<span class="owned-tag">to '+entry[1].team+' (#'+entry[0]+')</span>';
      }
      const btn = isDrafted
        ? '<span class="owned-tag">Drafted</span>'
        : (isAdmin
            ? '<button class="draft-btn" data-action="draft" data-id="'+p.id+'" '+(onClockTeam?'':'disabled')+'>Draft to '+(onClockTeam||"—")+'</button>'
            : '<span class="owned-tag">on board</span>');
      return '<tr class="'+(isDrafted?'drafted':'')+'">'+
        '<td><span class="pname">'+escapeHtml(p.name)+'</span>'+(ownerTag?'<br>'+ownerTag:'')+'</td>'+
        '<td><span class="pos-chip '+p.pos+'">'+p.pos+'</span></td>'+
        '<td style="color:var(--chalk-dim); font-size:12px;">'+escapeHtml(p.nflTeam||"")+'</td>'+
        '<td>'+btn+'</td>'+
      '</tr>';
    }).join("");
  }
  const mini = document.getElementById("miniOrder");
  const upcoming = order.slice(Math.max(idx,0), idx+12);
  mini.innerHTML = upcoming.map((p,i)=>{
    const real_i = idx+i;
    return orderRowHtml(p, real_i===idx, false);
  }).join("");
}
