async function loadMyTeam(){
  let neverAsked = true;
  try{
    const v = localStorage.getItem(MY_TEAM_KEY);
    if(v !== null){
      neverAsked = false;
      if(v !== '__SKIP__') myTeam = v;
    }
  }catch(e){ /* nothing claimed yet on this device */ }
  renderMyTeamPill();
  return neverAsked;
}
async function saveMyTeam(value){
  try{
    localStorage.setItem(MY_TEAM_KEY, value);
  }catch(e){ /* non-fatal — attribution is a convenience, not critical */ }
}
async function claimTeam(){
  const REAL_OWNERS = OWNERS.filter(o=>o!=='Unassigned');
  const result = await showModal({
    title: myTeam ? "Change your team" : "Which team are you?",
    message: "This just labels trades you submit as coming from your team — it isn't a password, so anyone at your team's device can still act for you.",
    options: REAL_OWNERS,
    confirmLabel: "Save",
    showSkip: true
  });
